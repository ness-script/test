		Duration = 3
	})
end)

local function Load(url, name)
	Fluent:Notify({ Title = "Loading", Content = name, Duration = 2 })
	task.spawn(function()
		local ok, res = pcall(game.HttpGet, game, url)
		if not ok then return Fluent:Notify({ Title = "Error", Content = "Download failed", Duration = 3 }) end
		local ok2, fn = pcall(loadstring, res)
		if not ok2 then return Fluent:Notify({ Title = "Error", Content = "Invalid script", Duration = 3 }) end
		pcall(function() Window:Destroy() end)
		getgenv().NessHubLoaded = false
		pcall(fn)
	end)
end

